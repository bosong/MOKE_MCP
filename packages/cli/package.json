{
  "name": "@moke-mcp/cli",
  "version": "0.1.3",
  "type": "module",
  "bin": {
    "moke-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "scripts/mockplus"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts --format esm --dts --watch",
    "clean": "rm -rf dist",
    "copy:scripts": "node ../../scripts/copy-mockplus.mjs cli",
    "prepack": "npm run copy:scripts && npm run build"
  },
  "dependencies": {
    "@moke-mcp/server": "workspace:*",
    "commander": "^12.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0"
  }
}
